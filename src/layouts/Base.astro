---
import '../styles/global.css';
import { site } from '../data/site';

interface Props { title: string; description: string; active?: 'work' | 'oss' }
const { title, description, active = 'work' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Nunito:wght@900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav>
      <div class="wrap">
        <a class="logo" href="/" aria-label="Home">A.</a>
        <div class="links">
          <a class:list={[{ on: active === 'work' || active === 'oss' }]} href="/#work">Work</a>
          <a class="about" href="/#about">About</a>
          <a href={site.links.resume} target="_blank" rel="noopener">Resume</a>
        </div>
      </div>
    </nav>
    <slot />
    <script>
      // Shrink the header once the page scrolls under it, tuck it away while
      // scrolling down, and bring it back on any scroll up.
      const nav = document.querySelector('nav')!;
      let last = scrollY;
      const update = () => {
        const y = scrollY;
        nav.classList.toggle('scrolled', y > 4);
        if (Math.abs(y - last) > 6) {
          nav.classList.toggle('tucked', y > last && y > 120 && !nav.contains(document.activeElement));
          last = y;
        }
      };
      addEventListener('scroll', update, { passive: true });
      nav.addEventListener('focusin', () => nav.classList.remove('tucked'));
      update();
    </script>
  </body>
</html>
