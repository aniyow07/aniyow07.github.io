---
import '../styles/global.css';
import { site } from '../data/site';

interface Props { title: string; description: string; active?: 'work' }
const { title, description, active = 'work' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Nunito:wght@900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav>
      <div class="wrap">
        <a class="logo" href="/" aria-label="Home">A.</a>
        <div class="links">
          <a class:list={[{ on: active === 'work' }]} href="/#work">Work</a>
          <a href="/#about">About</a>
          <a href={site.links.resume}>Resume</a>
        </div>
      </div>
    </nav>
    <slot />
  </body>
</html>
