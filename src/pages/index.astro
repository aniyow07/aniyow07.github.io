---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title={`${site.name} | AI/ML engineer portfolio`} description="Projects in LLMs, agents, computer vision and fast tools.">
  <main class="wrap">
    <Hero />
    <section class="grid" id="work">
      {projects.map((p) => <ProjectCard project={p} />)}
    </section>
  </main>
  <footer><div class="wrap">© 2026 {site.name}</div></footer>
</Base>

<script>
  import '../scripts/autoplay';
</script>
