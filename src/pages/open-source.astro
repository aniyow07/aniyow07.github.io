---
import Base from '../layouts/Base.astro';
import OssLive from '../components/OssLive.astro';
import { renderList } from '../data/oss-core';
import { site } from '../data/site';
import { getContributions } from '../data/oss';

const oss = await getContributions();
---
<Base title={`Open source | ${site.name}`} description="Pull requests to open source projects, pulled from GitHub." active="oss">
  <main class="wrap">
    <section class="oss" id="oss">
      <h1>Open source</h1>
      <p class="oss-lede">Pull requests I've made to other people's projects, pulled live from GitHub.</p>
      {oss.length === 0 && <p class="oss-lede">Nothing to show right now. See <a href={site.links.github}>GitHub</a>.</p>}
      <div class="oss-list" data-oss-list set:html={renderList(oss)} />
      <OssLive groups={oss} />
    </section>
  </main>
  <footer><div class="wrap">© 2026 {site.name}</div></footer>
</Base>
